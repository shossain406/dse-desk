{
  "name": "dse-desk",
  "version": "1.2.0",
  "private": true,
  "description": "Personal DSE investment manager - live prices, portfolio P/L, watchlist, alerts, charts",
  "scripts": {
    "build:web": "esbuild src/app.js --bundle --minify --format=iife --target=es2020,chrome80 --outfile=www/app.js",
    "sync": "npm run build:web && cap sync android",
    "build:apk": "npm run sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5"
  }
}
